# ---------------------------------------------------------------------------
# Nothing here is required to run the app.
#
# This is a local, single-user application: the database and all files live in
# ./data, and `npm run dev` works with this file completely empty. Add keys
# only as you reach the phase that needs them.
# ---------------------------------------------------------------------------

# Where the database and asset files live. Defaults to ./data in the project.
# Point this somewhere else if you'd rather keep your data outside the repo.
WILLELEMENTS_DATA_DIR=

# The origin this app is served from. Used to build OBS browser-source URLs and
# OAuth redirect URLs. Defaults to http://localhost:3000.
APP_URL=

# ---------------------------------------------------------------------------
# Phase 4 — Twitch. Create an app at https://dev.twitch.tv/console
# OAuth Redirect URL (must match exactly): http://localhost:3000/api/twitch/callback
# Client Type: Confidential
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Encrypts provider tokens at rest, so a copied database is not readable on its
# own. Optional — one is generated into data/.token-key on first use. Set it
# explicitly if you would rather keep the key out of the data folder.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Phase 9 — OpenAI image generation. The only part of this project that costs
# money, and entirely optional.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Phase 10 — YouTube / Google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
