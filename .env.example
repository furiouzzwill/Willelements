# ---------------------------------------------------------------------------
# Phase 1 — required to run the app
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose: every table it reaches
# is protected by Row Level Security. The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
# is still read as a fallback, but Supabase is retiring it — prefer this one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin of this deployment. Used for auth email redirect links and,
# later, OAuth callback and OBS browser-source URLs.
# Leave unset locally to default to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Server-only. NEVER prefix these with NEXT_PUBLIC_ and never log their values.
# ---------------------------------------------------------------------------

# Secret key (sb_secret_...). Bypasses RLS — used only by webhook ingestion and
# background workers. Legacy SUPABASE_SERVICE_ROLE_KEY is read as a fallback.
# Not required until Phase 7.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Later phases. Listed here so the surface is visible; not read yet.
# ---------------------------------------------------------------------------

# Phase 4 — Twitch OAuth (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Phase 7 — Twitch EventSub webhook signature verification.
# A random secret you choose, 10-100 characters.
TWITCH_EVENTSUB_SECRET=

# Phase 9 — OpenAI image generation
OPENAI_API_KEY=

# Phase 10 — YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
